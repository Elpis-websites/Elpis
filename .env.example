# Copia questo file in .env.local per provare il sito sul tuo computer (npm run dev).
# Su Vercel NON si usa un file: le stesse variabili si inseriscono in Project Settings > Environment Variables.
# Non inserire mai valori veri in questo file e non salvare .env.local nel repository.

# Indirizzo pubblico del sito, senza barra finale. Finché manca, il sito si dichiara "in preparazione" e dice ai motori di ricerca di non indicizzarlo.
# TODO-CLIENTE: inserire il dominio reale quando esiste.
# SITE_URL=https://www.esempio.it

# Server di posta (SMTP) da cui parte l'email del modulo contatti.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" solo per la porta 465; se manca, si decide dalla porta.
SMTP_SECURE=
# Mittente (deve essere un indirizzo che il server SMTP ti permette di usare).
MAIL_FROM=
# Chi riceve le richieste dei clienti. TODO-CLIENTE: indirizzo ancora da decidere.
CONTACT_TO=
